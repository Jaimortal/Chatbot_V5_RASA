{
  "name": "buksu-monorepo",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:server": "cross-env NODE_ENV=development tsx server/index.ts",
    "dev:chat": "cd packages/chat-app && npm run dev",
    "dev:admin": "cd packages/admin-app && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:chat\" \"npm run dev:admin\"",
    "build:chat": "cd packages/chat-app && npm run build",
    "build:admin": "cd packages/admin-app && npm run build",
    "build": "npm run build:chat && npm run build:admin",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.39.3",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.3",
    "memorystore": "^1.6.7",
    "nodemailer": "^7.0.12",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.19.0",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/ws": "^8.5.13",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.18.1",
    "tsx": "^4.20.5",
    "typescript": "5.6.3"
  }
}