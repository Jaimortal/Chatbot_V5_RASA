# Environment Configuration for BukSU Chatbot
# Copy this file to .env and update values for your environment

# Application Environment
NODE_ENV=development
# Options: development, staging, production

# Server Configuration
PORT=5005
HOST=localhost

# Rasa Configuration
RASA_MODEL_PATH=models/
RASA_NLU_DATA=data/
RASA_DOMAIN_DATA=domain.yml
RASA_CONFIG_DATA=config.yml
RASA_ENDPOINT=http://localhost:5005/webhooks/rest/webhook

# Database Configuration (if using external database)
# DATABASE_URL=postgresql://username:password@localhost:5432/buksu_chatbot
# DATABASE_URL=mongodb://localhost:27017/buksu_chatbot

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
API_KEY=your-api-key-for-external-services

# Logging
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/app.log

# External Services
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# FACEBOOK_PAGE_TOKEN=your-facebook-page-token

# File Upload Limits
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration
CACHE_TTL=3600
REDIS_URL=redis://localhost:6379

# Monitoring
ENABLE_MONITORING=true
SENTRY_DSN=your-sentry-dsn-for-error-tracking

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CHAT_HISTORY=true
ENABLE_MAP_INTEGRATION=true
